{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "class-notes-web",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "cyborgmass.ir",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
