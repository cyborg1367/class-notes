{
  "name": "class-notes-public",
  "private": true,
  "scripts": {
    "build:course": "node frontend/project.mjs frontend",
    "test:course": "node --test tests/course-filter.test.mjs",
    "typecheck:course": "tsc --project frontend/tsconfig.json",
    "build": "node frontend/project.mjs build",
    "dev": "node frontend/project.mjs dev",
    "check": "node frontend/project.mjs check",
    "preview:cloudflare": "npm run build && wrangler dev --local --port 8787",
    "deploy:cloudflare": "npm run check && wrangler deploy",
    "typecheck:browser": "tsc --project tests/browser/tsconfig.json",
    "test:browser": "playwright test",
    "test:browser:chromium": "playwright test --project=desktop-chromium --project=mobile-chromium --project=narrow-chromium",
    "test:browser:report": "playwright show-report"
  },
  "dependencies": {
    "anatomy-figures": "0.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "linkedom": "0.18.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "wrangler": "4.160.0"
  }
}
